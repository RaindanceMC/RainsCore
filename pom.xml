<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.raindancer</groupId>
    <artifactId>RainsCore</artifactId>
    <version>2.12.0</version>
    <packaging>jar</packaging>

    <name>RainsCore</name>
    <description>Rain's Core — the one implementation of everything Rain's plugins do to the game</description>

    <properties>
        <!--
          Same floor as every other plugin here: Paper 26.2 ships class files at version 69, so a JDK
          below 25 cannot read paper-api at all and the build fails rather than producing a jar that
          only pretends to be portable.
        -->
        <java.version>25</java.version>
        <paper.api.version>26.3.build.169-beta</paper.api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Kept in step with Rain's Flexible Modules, so a class mocked in both behaves the same way. -->
        <mockito.version>5.21.0</mockito.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- VaultAPI is only published on JitPack. -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Compile-only, the same as WorldEdit is for the hungergames module: Messages calls
          PlaceholderAPI.setPlaceholders directly rather than through reflection, but only ever behind a
          Bukkit.getPluginManager().isPluginEnabled("PlaceholderAPI") check, so the class is never loaded
          — let alone linked against a missing plugin — on a server that does not have it installed. Not
          declared as a runtime dependency anywhere: PlaceholderAPI is entirely optional.
        -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Compile-only, the same treatment as PlaceholderAPI above: Grants calls the LuckPerms API
          directly, but only from a backend that is never constructed unless
          Bukkit.getPluginManager().getPlugin("LuckPerms") is non-null, so the class is never loaded on
          a server that does not have it installed. On Maven Central — no extra repository needed.
        -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!--
          Compile-only, the same treatment again: VaultBridge is constructed only when Vault is installed,
          so its classes are never linked on a server without it. Bukkit excluded — paper-api is the API here.
        -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <!--
          The same driver Paper ships inside its own jar, at the same version, and only for tests.

          Paper carries org.xerial:sqlite-jdbc in META-INF/libraries, so on a real server the driver
          is already there: nothing is declared, nothing is downloaded at startup, and the rule that
          this plugin has no runtime dependencies still holds. Verified on a running server rather
          than assumed — see the sqlite checks in RainsCoreTestPlugin.

          Test scope exists so the storage layer can be tested against a real database instead of
          against a mock of one. A fake that answers queries the way we expect proves only that we
          are consistent with ourselves; SQLite's own opinions about types, transactions and locking
          are the entire reason to write tests here.

          Keep this version in step with Paper's. If they diverge, the tests pass against one engine
          and the server runs on another.
        -->
        <!--
          The PostgreSQL driver, the one dependency that ships inside the jar (2.0.0, decision N10 in
          NETWORK-PLAN.md). A network keeps everything in one central Postgres, and Paper only carries
          drivers for SQLite and MySQL. Shaded and relocated under de.raindancer.core.internal.postgresql
          rather than fetched through paper-plugin.yml's libraries: — nothing is downloaded at startup,
          an offline server still loads, and another plugin's copy of the driver cannot collide with it.
          BSD-2-Clause, recorded in THIRD-PARTY.md. checker-qual is annotations only and not needed at runtime.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.8</version>
            <exclusions>
                <exclusion>
                    <groupId>org.checkerframework</groupId>
                    <artifactId>checker-qual</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.49.1.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          Mockito, for the tests only, and for one specific job: the Bukkit types.

          Nothing in this plugin's own design needs a mock. Everything Core decides is decided by a class
          that takes plain values and can be constructed in a test — that is what the rules/services split
          is for, and a test that mocks one of those is testing that we are consistent with ourselves.

          What cannot be constructed in a test is Paper's half: Player, World, Block, Location, Server,
          ItemStack. Those are interfaces with no implementation on the test classpath, so anything that
          genuinely has to speak to one — a listener translating an event, a menu building an icon, a
          teleport picking a destination — was previously untestable and simply had no test. That is the gap
          this closes, and it is the only thing it is here for.

          Two notes that have already cost time:
            - The inline mock maker is what allows a *final* class with a package-private constructor to be
              mocked. LogChannel is exactly that, and it is what a test wants to capture rather than print.
            - Record a mock's calls with a default answer — mock(Type.class, call -> ...) — rather than
              stubbing a varargs method. A matcher for Object... silently fails to bind the array, and the
              assertion then checks an empty list and passes.
        -->
        <!-- Waiting for what another server (another bus, another pool) does, without fixed sleeps. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial,-processing</arg>
                    </compilerArgs>
                    <!--
                      fork=true: the in-process javac this plugin uses by default started throwing a
                      bare NullPointerException (no message, no useful stack) on a cold `clean install`
                      once the module passed a few hundred source files — reproducible on this JDK 25
                      toolchain, gone on a warm recompile, and gone for good once javac runs in its own
                      process instead of Maven's. A forked process costs a JVM start per compile, which
                      is nothing next to a build that cannot be trusted to finish.
                    -->
                    <fork>true</fork>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!--
                      Mockito instruments classes through Byte Buddy, which as shipped with the version
                      above does not yet recognise Java 25 (class file 69) bytecode — the JDK this project
                      already requires — and refuses to mock anything at all without this. Not a
                      preference: see java.version for why 25 is not optional here.
                    -->
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
                <executions>
                    <!--
                      Every store test (tagged "database") once more against PostgreSQL, the database a
                      network keeps everything in. TestDatabases hands them a Postgres namespace instead of a
                      SQLite file; TestPostgres starts a throwaway server or uses CI's.
                    -->
                    <execution>
                        <id>stores-on-postgres</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <groups>database</groups>
                            <reportNameSuffix>postgres</reportNameSuffix>
                            <systemPropertyVariables>
                                <rains.test.dialect>postgresql</rains.test.dialect>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  The testkit (de.raindancer.core.testkit) ships as RainsCore-<version>-tests.jar so module
                  tests can build items, inventories and players without a server. Only the kit and the
                  service file that registers its registries go in, never Core's own tests. A module uses it as
                  <dependency> ... <artifactId>RainsCore</artifactId> <type>test-jar</type> <scope>test</scope>
                  plus mockito-core in test scope, which the kit is built on.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>testkit</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>de/raindancer/core/testkit/**</include>
                                <include>META-INF/services/io.papermc.paper.registry.RegistryAccess</include>
                            </includes>
                            <excludes>
                                <exclude>**/*Test.class</exclude>
                                <exclude>**/*Test$*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <!--
                  Relocating rewrites every class in the jar, Core's own included, and the ASM shade ships
                  with predates Java 25's class files (major 69). A newer ASM reads them.
                -->
                <dependencies>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>9.10.1</version>
                    </dependency>
                    <dependency>
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm-commons</artifactId>
                        <version>9.10.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!-- Modules compile against Core as provided; they must not inherit the driver. -->
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.postgresql:postgresql</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.postgresql</pattern>
                                    <shadedPattern>de.raindancer.core.internal.postgresql</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>org.postgresql:postgresql</artifact>
                                    <excludes>
                                        <!-- Core asks the driver directly; it is not registered with DriverManager. -->
                                        <exclude>META-INF/services/java.sql.Driver</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>packages-releases</id>
            <url>https://packages.tstieh.de/releases</url>
        </repository>
        <!-- Same credentials as releases (ci-deploy may write both), hence the same server id. -->
        <snapshotRepository>
            <id>packages-releases</id>
            <url>https://packages.tstieh.de/snapshots</url>
        </snapshotRepository>
    </distributionManagement>
</project>
